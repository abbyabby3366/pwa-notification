# Port the production server listens on
PORT=3000

# Target upstream site to wrap with PWA + iOS Web Push
UPSTREAM_URL=https://statsdashboard.onrender.com

# Optional: Customize PWA name shown on iOS Home Screen
PWA_NAME=Stats Dashboard
PWA_SHORT_NAME=Stats

# Optional: Provide your own VAPID keys and contact email/URL.
# If omitted, keys are generated automatically and saved to data/vapid-keys.json.
# VAPID_SUBJECT=mailto:you@yourdomain.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
