# Port the production server listens on
PORT=3000

# Optional: Enable Reverse-Proxy PWA Wrapper mode for an upstream site you don't control the repo for.
# When set, "/" and all upstream routes proxy to UPSTREAM_URL with PWA manifest, /sw.js,
# iOS meta tags, and a floating "Enable Notifications" button injected into HTML responses.
# Example (Option 2: single public domain pwa.neuron.my fronting internal pwaneuronmy):
# UPSTREAM_URL=http://pwaneuronmy:3000
# PWA_SHORT_NAME=Neuron App

# Optional: Provide your own VAPID keys and contact email/URL.
# If omitted, keys are generated automatically and saved to data/vapid-keys.json.
# VAPID_SUBJECT=mailto:you@yourdomain.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
